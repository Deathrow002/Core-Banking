	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Session auth: Postman's cookie jar keeps SESSION and XSRF-TOKEN (cookies are shared across ports on the same host).",
					"// Spring Security requires the XSRF-TOKEN cookie value echoed in X-XSRF-TOKEN on state-changing requests.",
					"const method = pm.request.method.toUpperCase();",
					"if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {",
					"    const send = (token) => pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token });",
					"    const existing = pm.cookies.get('XSRF-TOKEN');",
					"    if (existing) {",
					"        send(existing);",
					"    } else {",
					"        const url = pm.request.url;",
					"        const authBase = pm.variables.get('authUrl') || (url.protocol || 'http') + '://' + url.getRemote();",
					"        pm.sendRequest({ url: authBase + '/api/v1/auth/csrf', method: 'GET' }, (err, res) => {",
					"            const cookie = res && res.cookies.get('XSRF-TOKEN');",
					"            if (cookie) { send(cookie); } else { console.warn('Could not obtain XSRF-TOKEN', err); }",
					"        });",
					"    }",
					"}"
				]
			}
		}
	]
